local Stories = {}
local origins = {
	"Нашёл это при разборе семейного архива.", "Сосед принёс коробку вещей перед переездом.",
	"Эта вещь много лет стояла у нас на полке.", "Купил на воскресном рынке и теперь сомневаюсь.",
	"Унаследовал вместе со старым письменным столом.", "Забрал из закрывшейся мастерской.",
	"Мне подарили это после долгой поездки.", "Продавец уверял, что вещь редкая, но документов не дал.",
	"Нашёл в упаковке с пожелтевшей биркой.", "Хозяин коллекции попросил получить независимое мнение.",
	"Перебирал дачные ящики и наткнулся на этот предмет.", "Хочу передать вещь дальше и сначала узнать её историю."
}
local endings = { "Сколько она сейчас стоит?", "Мне важно понять, настоящая ли она.", "Если предложите честную цену, готов обсудить продажу.",
	"Не спешите, пожалуйста, с выводом о подлинности.", "Сначала хочу услышать вашу оценку.", "Не хотелось бы перепутать реставрацию с подделкой." }
function Stories.Build(def, item)
	local seed = math.floor(item.seed)
	local origin = origins[(seed % #origins) + 1]
	local ending = endings[(math.floor(seed / 17) % #endings) + 1]
	local state = if item.condition < 0.55 then "Состояние не идеальное, есть заметные следы времени."
		elseif item.condition < 0.8 then "Вещью пользовались, но старались беречь." else "Сохранилось хорошо; я даже боюсь лишний раз трогать."
	return origin .. " Говорят, это «" .. def.name .. "». " .. state .. " " .. ending
end
return Stories
