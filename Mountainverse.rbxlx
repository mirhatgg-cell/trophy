    <Item class="ModuleScript" referent="RBX00011767">
      <Properties>
        <string name="Name">Catalog</string>
        <ProtectedString name="Source">-- MOUNTAINVERSE authoritative trial and progression catalog.
local C = {}
C.GameVersion = 2
C.RoundsPerRun = 5
C.MutationChance = 0.001 -- 0.1% per victory; never sold for Robux.
C.AdminUserIds = {} -- Add trusted Roblox UserIds before publishing a group-owned place.
C.PublicTestAdmin = false -- Keep false in published games. Studio grants test admin automatically.
C.LevelWins = {1,3,5,8,12,17,23,30,39,50,64,81,102,128,160,198,244,299,365,450}
C.Tiers = {'Грязь','Глина','Камень','Медь','Бронза','Серебро','Золото','Рубин','Изумруд','Сапфир','Аметист','Обсидиан','Лёд','Плазма','Звёзды','Комета','Космос','Разлом','Вечность','Легенда'}
C.Palette = {
 Color3.fromRGB(88,60,40),Color3.fromRGB(156,94,63),Color3.fromRGB(114,126,135),Color3.fromRGB(186,101,63),
 Color3.fromRGB(177,130,62),Color3.fromRGB(192,209,220),Color3.fromRGB(255,205,65),Color3.fromRGB(239,62,92),
 Color3.fromRGB(49,220,144),Color3.fromRGB(54,128,255),Color3.fromRGB(177,91,255),Color3.fromRGB(52,40,75),
 Color3.fromRGB(154,239,255),Color3.fromRGB(255,75,216),Color3.fromRGB(255,240,179),Color3.fromRGB(255,143,61),
 Color3.fromRGB(108,82,255),Color3.fromRGB(255,49,115),Color3.fromRGB(217,255,245),Color3.fromRGB(255,255,255)
}
C.Games = {
 {id=1,name="TETRIS: LAST LINE",kind="tetris",players=4,minPlayers=4,width=80,depth=48,height=132,footprint=3840,floors=2,silhouette="Four reinforced pylons, overhead traverser and glazed curator tower",rules="Survivors collect line keys; curator locks seven tetromino shapes and clears ten-cell rows",death="Swept block impact and staged compression",reward=62,duration=100,story="Sector 01: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Concrete",variant=1},
 {id=2,name="PAC-MAN: THE HUNGER MAZE",kind="maze",players=6,minPlayers=1,width=108,depth=108,height=24,footprint=11664,floors=2,silhouette="Square masonry labyrinth under a perforated service roof",rules="Collect maze pellets and energizers while a graph-routed creature hunts",death="Creature captures the character in its closing jaw",reward=64,duration=100,story="Sector 02: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Concrete",variant=1},
 {id=3,name="DUEL: TWO THRONES",kind="duel",players=2,minPlayers=2,width=96,depth=72,height=64,footprint=6912,floors=2,silhouette="Opposed limestone and basalt keeps joined by three combat bridges",rules="Land server-validated sword strikes; collect the exposed central standard",death="Weapon impact or falling from a bridge",reward=66,duration=75,story="Sector 03: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Concrete",variant=1},
 {id=4,name="CHESS: KING’S EXECUTION",kind="chess",players=8,minPlayers=1,width=80,depth=80,height=40,footprint=6400,floors=2,silhouette="Eight-by-eight marble board inside a vaulted chess basilica",rules="Read legal chess moves and collect standards on empty squares",death="Moving chess piece sweeps the occupied square",reward=68,duration=75,story="Sector 04: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Concrete",variant=1},
 {id=5,name="SNAKE: THE COILING PIT",kind="snake",players=6,minPlayers=1,width=100,depth=100,height=72,footprint=10000,floors=3,silhouette="Three terraced rings enclosed by a segmented steel serpent",rules="Reach successive signal pads while the head routes around the pit",death="Contact with a moving snake segment",reward=70,duration=75,story="Sector 05: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Concrete",variant=1},
 {id=6,name="THE BROKEN SPAN",kind="bridge",players=8,minPlayers=1,width=32,depth=120,height=50,footprint=3840,floors=2,silhouette="Suspension bridge between two cracked abutments",rules="Cross to the far extraction pad as deck connections fail behind you",death="A warned deck panel breaks and the player falls",reward=72,duration=75,story="Sector 06: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Concrete",variant=1},
 {id=7,name="THE LAST ELEVATOR",kind="lift",players=6,minPlayers=1,width=64,depth=64,height=112,footprint=4096,floors=2,silhouette="Four-rail lift shaft with recessed floor landings",rules="Ride the lift and exit at the marked landing before the counterweight sweep",death="Falling into the shaft or meeting a counterweight",reward=74,duration=75,story="Sector 07: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Slate",variant=1},
 {id=8,name="ROTUNDA OF LOST NORTH",kind="rotatingmaze",players=6,minPlayers=1,width=100,depth=100,height=32,footprint=10000,floors=2,silhouette="Three concentric rotating masonry drums",rules="Align radial doors and collect seals in the outer ring",death="Contact with the closing radial gates",reward=76,duration=75,story="Sector 08: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Slate",variant=1},
 {id=9,name="THE SILENT ORCHESTRA",kind="rhythm",players=8,minPlayers=1,width=96,depth=72,height=36,footprint=6912,floors=2,silhouette="Acoustic amphitheatre with organ pipes and suspended resonators",rules="Stand on the indicated numbered acoustic pad on each beat",death="Being on an unpowered tile when a resonator fires",reward=78,duration=75,story="Sector 09: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Slate",variant=1},
 {id=10,name="THE GLACIAL ARCHIVE",kind="frozen",players=6,minPlayers=1,width=88,depth=88,height=42,footprint=7744,floors=2,silhouette="Translucent ice vault with ribbed rock buttresses",rules="Alternate between heat braziers and frozen archive terminals",death="Cold exposure reaches its limit; freezing animation",reward=80,duration=75,story="Sector 10: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Slate",variant=1},
 {id=11,name="CALDERA OF ASH",kind="volcano",players=8,minPlayers=1,width=100,depth=100,height=52,footprint=10000,floors=2,silhouette="Basalt caldera with three raised eruption vents",rules="Collect obsidian seals as vents erupt in a visible sequence",death="Lava vent impact or contact with the rising rim of lava",reward=82,duration=75,story="Sector 11: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Slate",variant=1},
 {id=12,name="DOMINO CATHEDRAL",kind="domino",players=6,minPlayers=1,width=96,depth=96,height=48,footprint=9216,floors=2,silhouette="Two stone galleries flanking a monumental domino procession",rules="Navigate between falling domino chains to collect the final seal",death="Swept falling domino face",reward=84,duration=75,story="Sector 12: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Slate",variant=1},
 {id=13,name="THE REMEMBERING ROOM",kind="memory",players=8,minPlayers=1,width=80,depth=80,height=28,footprint=6400,floors=2,silhouette="Dark slate memory chamber with an illuminated coffer ceiling",rules="Memorize safe cells before the projection turns off",death="Standing on an unsupported cell during the reveal",reward=86,duration=75,story="Sector 13: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Metal",variant=1},
 {id=14,name="TOWER OF DUST",kind="tower",players=8,minPlayers=1,width=72,depth=72,height=100,footprint=5184,floors=3,silhouette="Four-storey concrete tower with a visible demolition spine",rules="Climb the linked stairs while lower floors are removed in order",death="Collapse of the occupied level",reward=88,duration=75,story="Sector 14: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Metal",variant=1},
 {id=15,name="GYROSCOPE COURT",kind="rotor",players=6,minPlayers=1,width=100,depth=100,height=36,footprint=10000,floors=2,silhouette="Circular metal court inside a three-axis bearing frame",rules="Cross the rotating arms and collect gyroscope keys",death="Arm impact or falling outside the bearing ring",reward=90,duration=75,story="Sector 15: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Metal",variant=1},
 {id=16,name="THE CARTOGRAPHER’S LIE",kind="curatormaze",players=6,minPlayers=1,width=108,depth=108,height=28,footprint=11664,floors=2,silhouette="Orthogonal maze with a raised switch gallery",rules="Curator reroutes marked gates; survivors gather three map fragments",death="Gate compression or routed hunter capture",reward=92,duration=75,story="Sector 16: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Metal",variant=1},
 {id=17,name="MIDNIGHT ESCAPEMENT",kind="clock",players=6,minPlayers=1,width=100,depth=100,height=60,footprint=10000,floors=2,silhouette="Open clock face held by a giant visible escapement frame",rules="Reach the bell refuge when minute and hour hands align",death="Swept minute hand or exposed gear tooth",reward=94,duration=75,story="Sector 17: an abandoned civic machine was converted into a regulated trial. The maintenance entrance records its last safe inspection.",material="Metal",variant=1},
