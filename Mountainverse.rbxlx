  st.bumpers={}; for i=1,5 do local a=i*(math.pi*2)/5; table.insert(st.bumpers,box(s,'Bumper',math.cos(a)*25,3,math.sin(a)*25,7,6,7,amber,Enum.Material.Metal)) end
 elseif k=='gravity' then
