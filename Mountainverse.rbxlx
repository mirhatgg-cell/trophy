 elseif k=='crane' then
  st.targetX=0; st.dropUntil=0; st.load=box(s,'Suspended cargo',0,30,0,14,12,14,steel,Enum.Material.Metal)
  st.cable=box(s,'Hoist cable',0,55,0,.4,44,.4,steel,Enum.Material.Metal); box(s,'Jib',0,80,0,100,5,5,steel)
 elseif k=='shift' then
