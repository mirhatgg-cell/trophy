	{["id"] = "i10", ["name"] = "Восковая печать", ["kind"] = "seal", ["spec"] = "Historian", ["value"] = 420, ["material"] = "бронза", ["era"] = "XIX век", ["weight"] = 120, ["mark"] = "герб с тремя башнями", ["color"] = "copper", ["story"] = "Нужна оценка самой матрицы, не оттиска."},
