	{["id"] = "t05", ["name"] = "Вакуумная лампа", ["kind"] = "tube", ["spec"] = "Technician", ["value"] = 140, ["material"] = "стекло и никель", ["era"] = "1950-е", ["weight"] = 68, ["mark"] = "серебристый геттер внутри", ["color"] = "amber", ["story"] = "Проверить нечем. С виду нить целая."},
