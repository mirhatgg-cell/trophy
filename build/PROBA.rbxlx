	{["id"] = "a19", ["name"] = "Печать забытого города", ["kind"] = "cylinderseal", ["spec"] = "Archaeologist", ["value"] = 5600, ["material"] = "серпентинит", ["era"] = "III тысячелетие до н. э.", ["weight"] = 74, ["mark"] = "непрерывная сцена прокатки", ["color"] = "green", ["story"] = "На оттиске видны ворота города, которого нет на картах."},
